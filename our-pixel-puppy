
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Наша собачка 💗</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #ffe9f2;
  color: #75465b;
  font-family: monospace;
  text-align: center;
  padding: 18px;
}
.game {
  max-width: 500px;
  margin: auto;
  background: #fff8fc;
  border: 4px solid #f4a9cb;
  border-radius: 18px;
  padding: 18px;
}
h1 { color: #d45d91; }
.room {
  background: #fbd4e6;
  border-bottom: 12px solid #c78caa;
  padding: 24px 8px;
  border-radius: 12px;
}
.dog {
  font-size: 86px;
  image-rendering: pixelated;
  margin: 12px;
}
.stats { text-align: left; margin: 16px 0; }
.stat { margin: 12px 0; }
.track {
  height: 14px;
  background: #f2d5e2;
  border-radius: 8px;
  overflow: hidden;
}
.fill {
  height: 100%;
  width: 70%;
  background: #e986b5;
  transition: width .3s;
}
button {
  background: #ed8bb8;
  color: white;
  border: 0;
  border-radius: 10px;
  padding: 12px;
  margin: 4px;
  font-family: inherit;
  font-size: 14px;
  cursor: pointer;
}
button:active { transform: scale(.97); }
.note {
  width: 100%;
  padding: 12px;
  border: 2px solid #f4b6d1;
  border-radius: 8px;
  margin-top: 10px;
}
.small { font-size: 12px; color: #a16c85; }
</style>
</head>
<body>
<div class="game">
  <h1>♡ Наш маленький дом ♡</h1>
  <p>Карина и Артём</p>
  <div class="room">
    <div>🏠 🪟 🌸 🪟 🏠</div>
    <div class="dog" id="dog">🐶</div>
    <div id="mood">Я рада вас видеть! 💗</div>
    <div>🦴　🥣　🧸</div>
  </div>
  <div class="stats">
    <div class="stat">🍖 Сытость: <span id="foodText">70</span>%
      <div class="track"><div class="fill" id="foodBar"></div></div>
    </div>
    <div class="stat">⚡ Энергия: <span id="sleepText">70</span>%
      <div class="track"><div class="fill" id="sleepBar"></div></div>
    </div>
    <div class="stat">💗 Настроение: <span id="happyText">70</span>%
      <div class="track"><div class="fill" id="happyBar"></div></div>
    </div>
  </div>
  <h3>Позаботься обо мне!</h3>
  <button onclick="act('food')">🥣 Покормить</button>
  <button onclick="act('sleep')">🛏️ Спать</button>
  <button onclick="act('play')">🧸 Играть</button>
  <h3>🪙 Наш кошелёк: <span id="coins">10</span></h3>
  <button onclick="earn()">🎁 Получить 5 монет</button>
  <h3>💌 Записка друг другу</h3>
  <input id="note" class="note" placeholder="Напиши что-нибудь милое...">
  <button onclick="saveNote()">Сохранить записку</button>
  <p id="savedNote"></p>
  <p class="small">Наша маленькая семья 💗</p>
</div>
<script>
const defaults = { food:70, sleep:70, happy:70, coins:10, note:"" };
let state;
try {
  state = {...defaults, ...JSON.parse(localStorage.getItem("puppy-save"))};
} catch(e) {
  state = {...defaults};
}
function save() {
  localStorage.setItem("puppy-save", JSON.stringify(state));
  render();
}
function act(type) {
  if(type === "food") {
    state.food = Math.min(100, state.food + 20);
    state.coins = Math.max(0, state.coins - 1);
    state.mood = "Ням-ням! Спасибо! 💗";
  }
  if(type === "sleep") {
    state.sleep = Math.min(100, state.sleep + 25);
    state.mood = "Сладких снов! 💤";
  }
  if(type === "play") {
    state.happy = Math.min(100, state.happy + 20);
    state.sleep = Math.max(0, state.sleep - 10);
    state.mood = "Ура, давай ещё! 🎾";
  }
  save();
}
function earn() {
  state.coins += 5;
  state.mood = "Мы заработали монетки! 🪙";
  save();
}
function saveNote() {
  state.note = document.getElementById("note").value;
  save();
}
function render() {
  ["food","sleep","happy"].forEach(k => {
    document.getElementById(k+"Text").textContent = state[k];
    document.getElementById(k+"Bar").style.width = state[k]+"%";
  });
  document.getElementById("coins").textContent = state.coins;
  document.getElementById("mood").textContent =
    state.mood || "Я рада вас видеть! 💗";
  document.getElementById("note").value = state.note || "";
  document.getElementById("savedNote").textContent =
    state.note ? "💌 Записка: " + state.note : "";
}
render();
</script>
</body>
</html>
